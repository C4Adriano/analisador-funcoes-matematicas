{
    "compilerOptions": {
        "lib": ["ES2025", "DOM"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2025",

        "outDir": "src",
        "rootDir": "src",

        "declaration": false,
        "exactOptionalPropertyTypes": true,
        "noEmit": false,
        "noEmitOnError": true,
        "noImplicitAny": false,
        "noUncheckedIndexedAccess": true,
        "removeComments": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true
    },

    "files": ["src/global.d.ts"],
    "include": ["src/*.ts"],
    "exclude": ["src/*.d.ts", "pessoal"]
}
