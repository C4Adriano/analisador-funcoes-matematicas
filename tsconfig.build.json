{
    "compilerOptions": {
        "target": "es2025",
        "lib": ["ES2025", "DOM"],
        "module": "nodenext",
        "moduleResolution": "nodenext",

        "rootDir": "src",
        "outDir": "src",

        "declaration": false,
        "noEmit": false,
        "resolveJsonModule": true,
        "removeComments": true,
        "strict": true,

        "skipLibCheck": true,
        "noImplicitAny": false,

        "noUncheckedIndexedAccess": true,
        "noEmitOnError": true,
        "exactOptionalPropertyTypes": true
    },

    "include": [
        "src/config.ts",
        "src/state.ts",
        "src/i18n.ts",
        "src/global.d.ts"
    ],
    "exclude": ["pessoal/**"]
}
