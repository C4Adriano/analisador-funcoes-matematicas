{
    "tabWidth": 4,
    "endOfLine": "lf",
    "useTabs": false,
    "bracketSpacing": true,
    "printWidth": 120,
    "embeddedLanguageFormatting": "auto",
    "trailingComma": "none",

    "overrides": [
        {
            "files": ["*.js", "*.jsx", "*.ts", "*.tsx", "*.mjs", "*.cjs"],
            "options": {
                "semi": false,
                "singleQuote": false,
                "trailingComma": "es5",
                "arrowParens": "avoid",
                "quoteProps": "as-needed"
            }
        },
        {
            "files": ["*.md", "*.markdown", "*.mdx", "*.mdown", "*.mkd", "*.mkdn", "*.mdwn", "*.mdtxt", "*.mdtext"],
            "options": {
                "printWidth": 80,
                "proseWrap": "preserve"
            }
        },
        {
            "files": ["*.html", "*.htm", "*.xhtml"],
            "options": {
                "htmlWhitespaceSensitivity": "ignore",
                "singleAttributePerLine": false,
                "bracketSameLine": true
            }
        },
        {
            "files": ["*.css", "*.less", "*.scss", "*.sass", "*.styl", "*.stylus"],
            "options": {
                "singleQuote": false
            }
        },
        {
            "files": [
                "*.json",
                "*.jsonc",
                "*.json5",
                "*.jsonl",
                "*.jsonlnd",
                "*.jsonlndc",
                "*.jsonlnd5",
                "*.jsonlndc5"
            ],
            "options": {
                "printWidth": 80
            }
        },
        {
            "files": [
                "*.yaml",
                "*.yml",
                "*.toml",
                "*.ini",
                "*.conf",
                "*.cfg",
                "*.properties",
                "*.env",
                "*.env.local",
                "*.env.development",
                "*.env.test",
                "*.env.production"
            ],
            "options": {
                "tabWidth": 2,
                "singleQuote": false,
                "proseWrap": "preserve"
            }
        }
    ]
}
