{
    "semi": false,
    "singleQuote": false,
    "tabWidth": 4,
    "printWidth": 120,
    "endOfLine": "lf",
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "quoteProps": "as-needed",
    "useTabs": false,

    "overrides": [
        {
            "files": "*.md",
            "options": {
                "printWidth": 80,
                "proseWrap": "preserve"
            }
        },
        {
            "files": "*.html",
            "options": {
                "printWidth": 120,
                "tabWidth": 4,
                "htmlWhitespaceSensitivity": "css",
                "singleAttributePerLine": false,
                "bracketSameLine": false,
                "embeddedLanguageFormatting": "auto"
            }
        },
        {
            "files": "*.css",
            "options": {
                "printWidth": 120,
                "tabWidth": 4,
                "singleQuote": false
            }
        },
        {
            "files": "*.json",
            "options": {
                "printWidth": 80,
                "tabWidth": 4
            }
        }
    ]
}
