{
    "tabWidth": 4,
    "endOfLine": "lf",
    "useTabs": false,
    "bracketSpacing": true,
    "printWidth": 120,
    "embeddedLanguageFormatting": "auto",
    "trailingComma": "none",

    "overrides": [
        {
            "files": ["*.js"],
            "options": {
                "semi": false,
                "singleQuote": false,
                "trailingComma": "es5",
                "arrowParens": "avoid",
                "quoteProps": "as-needed"
            }
        },
        {
            "files": ["*.md"],
            "options": {
                "printWidth": 80,
                "proseWrap": "preserve"
            }
        },
        {
            "files": ["*.html", "*.htm", "*.xhtml"],
            "options": {
                "htmlWhitespaceSensitivity": "ignore",
                "singleAttributePerLine": false,
                "bracketSameLine": true
            }
        },
        {
            "files": ["*.css"],
            "options": {
                "singleQuote": false
            }
        },
        {
            "files": ["*.json", "*.jsonc"],
            "options": {
                "printWidth": 80
            }
        },
        {
            "files": ["*.yaml", "*.yml"],
            "options": {
                "tabWidth": 2,
                "singleQuote": false,
                "proseWrap": "preserve"
            }
        }
    ]
}
