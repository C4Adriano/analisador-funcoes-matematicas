{
    "semi": false,
    "singleQuote": false,
    "tabWidth": 4,
    "printWidth": 120,
    "endOfLine": "lf",
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "quoteProps": "as-needed",
    "useTabs": false,

    "overrides": [
        {
            "files": "*.md",
            "options": {
                "printWidth": 80,
                "proseWrap": "preserve"
            }
        }
    ]
}