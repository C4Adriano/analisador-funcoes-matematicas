{
    "compilerOptions": {
        "target": "es2025",
        "lib": ["ES2025", "DOM"],
        "module": "nodenext",
        "moduleResolution": "nodenext",

        "rootDir": "./src/TS",
        "outDir": "./src/JS",

        "allowJs": true,
        "checkJs": true,
        "resolveJsonModule": true,

        "strict": true,

        "sourceMap": true,

        "skipLibCheck": true,

        "noUncheckedIndexedAccess": true,
        "noEmitOnError": true,
        "exactOptionalPropertyTypes": true
    },

    "include": ["./src/TS/**/*"],
    "exclude": ["./pessoal/*", "./node_modules/*"]
}
