{
    "compilerOptions": {
        "target": "es2025",
        "module": "esnext",
        "types": ["node"],

        "rootDir": "./src/TS",
        "outDir": "./src/JS",

        "allowJs": true,
        "checkJs": true,
        "resolveJsonModule": true,

        "strict": true,

        "sourceMap": true,

        "skipLibCheck": true,

        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true
    },

    "include": ["./src/TS/*"],
    "exclude": ["./pessoal/*", "./node_modules/*"]
}
