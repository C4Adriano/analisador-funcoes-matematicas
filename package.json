{
  "name": "analisador",
  "version": "6.6.3",
  "description": "Mathematical Function Analyzer / Analisador de Funções Matemáticas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C4Adriano/analisador-funcoes-matematicas.git"
  },
  "keywords": [
    "mathematics",
    "math",
    "function",
    "analyzer",
    "analisador",
    "função",
    "matemática",
    "typescript",
    "i18n",
    "trigonometry",
    "trigonometria"
  ],
  "author": "Adriano Lima",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bugs": {
    "url": "https://github.com/C4Adriano/analisador-funcoes-matematicas/issues"
  },
  "homepage": "https://github.com/C4Adriano/analisador-funcoes-matematicas#readme",
  "scripts": {
    "build": "tsc",
    "build:css": "sass src/style.scss src/style.css --no-source-map",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,jsonc,json5,html,css,scss,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3"
  }
}
