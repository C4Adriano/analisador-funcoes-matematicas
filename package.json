{
  "name": "analisador",
  "version": "7.1.0",
  "description": "Mathematical Function Analyzer / Analisador de Funções Matemáticas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C4Adriano/analisador-funcoes-matematicas.git"
  },
  "keywords": [
    "analisador",
    "analyzer",
    "function",
    "função",
    "i18n",
    "matemática",
    "math",
    "mathematics",
    "trigonometria",
    "trigonometry",
    "typescript"
  ],
  "author": "Adriano Lima",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bugs": {
    "url": "https://github.com/C4Adriano/analisador-funcoes-matematicas/issues"
  },
  "homepage": "https://github.com/C4Adriano/analisador-funcoes-matematicas#readme",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:css": "sass src/CSS/style.scss src/CSS/style.css --no-source-map",
    "fix": "npm run format && npm run lint:fix && npm run build",
    "fix:all": "npm run format && npm run lint:fix && npm run lint:md:fix && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:all": "npm run lint && npm run lint:css && npm run lint:html && npm run lint:md",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "lint:fix": "eslint . --fix",
    "lint:html": "html-validate \"index.html\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "prepare": "husky",
    "typecheck": "tsc --project tsconfig.build.json --noEmit",
    "watch": "tsc --project tsconfig.build.json --watch"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,jsonc,json5,html,css,scss,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@ivuorinen/stylelint-a11y": "^2.0.0",
    "@types/node": "^26.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-package-json": "^0.91.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-tsdoc": "^0.5.3",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.12.0",
    "html-validate": "^11.16.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-high-performance-animation": "^2.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@eslint/json": "^2.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
