{
    "name": "analisador",
    "version": "6.2.0",
    "description": "Mathematical Function Analyzer / Analisador de Funções Matemáticas",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/C4Adriano/analisador-funcoes-matematicas.git"
    },
    "keywords": [
        "mathematics",
        "math",
        "function",
        "analyzer",
        "analisador",
        "função",
        "matemática"
    ],
    "author": "Adriano Lima",
    "license": "UNLICENSED",
    "type": "module",
    "bugs": {
        "url": "https://github.com/C4Adriano/analisador-funcoes-matematicas/issues"
    },
    "homepage": "https://github.com/C4Adriano/analisador-funcoes-matematicas#readme",
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky"
    },
    "lint-staged": {
        "src/TS/**/*.ts": [
            "prettier --write"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@types/node": "^26.1.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "prettier": "^3.8.5",
        "typescript": "^6.0.3"
    }
}
