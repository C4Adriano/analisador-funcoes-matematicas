{
    "name": "analisador",
    "version": "6.2.3",
    "description": "Mathematical Function Analyzer / Analisador de Funções Matemáticas",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/C4Adriano/analisador-funcoes-matematicas.git"
    },
    "keywords": [
        "mathematics",
        "math",
        "function",
        "analyzer",
        "analisador",
        "função",
        "matemática"
    ],
    "author": "Adriano Lima",
    "license": "UNLICENSED",
    "type": "module",
    "bugs": {
        "url": "https://github.com/C4Adriano/analisador-funcoes-matematicas/issues"
    },
    "homepage": "https://github.com/C4Adriano/analisador-funcoes-matematicas#readme",
    "scripts": {
        "build": "tsc",
        "build:css": "sass src/style.scss src/style.css --no-source-map",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky"
    },
    "lint-staged": {
        "**/*.{js,ts,json,jsonc,json5,html,css,scss,md,yaml,yml}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "prettier": "^3.9.5",
        "sass": "^1.101.0",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "@parcel/watcher@2.5.6": true
    }
}
